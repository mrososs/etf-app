<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- إعدادات MIME types للأصول -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    
    <!-- إعدادات ضغط الملفات -->
    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="text/css" enabled="true" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="text/css" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
      </staticTypes>
    </httpCompression>
    
    <!-- إعدادات Cache للأصول -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
    
    <rewrite>
      <rules>
        <!-- قاعدة للتعامل مع Angular Routes -->
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- تجاهل الملفات الموجودة فعلياً -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            
            <!-- تجاهل API routes -->
            <add input="{REQUEST_URI}" pattern="^/api(/.*)?$" negate="true" />
            
            <!-- تجاهل الأصول -->
            <add input="{REQUEST_URI}" pattern="^/assets/.*" negate="true" />
            
            <!-- تجاهل ملفات الـ build -->
            <add input="{REQUEST_URI}" pattern="^/browser/.*" negate="true" />
            
            <!-- تجاهل ملفات الـ static -->
            <add input="{REQUEST_URI}" pattern="\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|map|json)$" negate="true" />
            
            <!-- تجاهل favicon -->
            <add input="{REQUEST_URI}" pattern="^/favicon\.ico$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/browser/index.html" />
        </rule>
        
        <!-- قاعدة إضافية للتعامل مع الأصول -->
        <rule name="Assets" stopProcessing="true">
          <match url="^assets/(.*)$" />
          <action type="Rewrite" url="/browser/assets/{R:1}" />
        </rule>
        
        <!-- قاعدة للتعامل مع ملفات الـ build -->
        <rule name="Build Files" stopProcessing="true">
          <match url="^(chunk-.*\.js|main-.*\.js|polyfills-.*\.js|scripts-.*\.js|styles-.*\.css)$" />
          <action type="Rewrite" url="/browser/{R:0}" />
        </rule>
      </rules>
    </rewrite>
    
    <!-- إعدادات الأمان -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
